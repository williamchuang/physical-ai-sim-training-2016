// Materials for the simulation. Solid colours only, so the 3x3 sensor
// images depend on geometry and shading, not on texture files.

material Pai/Track
{
    technique
    {
        pass
        {
            lighting off
            cull_hardware none
            diffuse vertexcolour
        }
    }
}

material Pai/Lit
{
    technique
    {
        pass
        {
            ambient 0.6 0.6 0.6
            specular 0.3 0.3 0.3 1 20
        }
    }
}

material Pai/Human : Pai/Lit
{
    technique
    {
        pass
        {
            ambient 0.85 0.15 0.12
            diffuse 0.85 0.15 0.12
        }
    }
}

material Pai/Neural : Pai/Lit
{
    technique
    {
        pass
        {
            ambient 0.15 0.35 0.9
            diffuse 0.15 0.35 0.9
        }
    }
}

material Pai/Scripted : Pai/Lit
{
    technique
    {
        pass
        {
            ambient 0.75 0.75 0.75
            diffuse 0.75 0.75 0.75
        }
    }
}

material Pai/Coin : Pai/Lit
{
    technique
    {
        pass
        {
            diffuse 1.0 0.85 0.2
            emissive 0.7 0.6 0.2
        }
    }
}

material Pai/Sun
{
    technique
    {
        pass
        {
            lighting off
            texture_unit
            {
                colour_op_ex source1 src_manual src_current 1.0 0.6 0.15
            }
        }
    }
}

material Pai/HudPanel
{
    technique
    {
        pass
        {
            lighting off
            scene_blend alpha_blend
            depth_check off
            texture_unit
            {
                colour_op_ex source1 src_manual src_current 0 0 0
                alpha_op_ex source1 src_manual src_current 0.45
            }
        }
    }
}

material Pai/ConsolePanel : Pai/HudPanel
{
    technique { pass { texture_unit { alpha_op_ex source1 src_manual src_current 0.7 } } }
}

material Pai/MenuPanel : Pai/HudPanel
{
    technique
    {
        pass
        {
            texture_unit
            {
                colour_op_ex source1 src_manual src_current 0.05 0.08 0.15
                alpha_op_ex source1 src_manual src_current 0.85
            }
        }
    }
}
